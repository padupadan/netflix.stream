      if (!slide) return;

      const img = document.getElementById('hero-bg-img');
      img.style.opacity = '0.3';
      setTimeout(() => {
        img.src = slide.bannerUrl;
        img.style.opacity = '1';
      }, 200);

      document.getElementById('hero-title').textContent = slide.title;
      document.getElementById('hero-category').textContent = slide.category;
      document.getElementById('hero-match').textContent = slide.matchScore;
      document.getElementById('hero-rating').textContent = slide.rating;
      document.getElementById('hero-duration').textContent = slide.duration;
      document.getElementById('hero-description').textContent = slide.description;

      // Update indicator pills
      const indicators = document.querySelectorAll('.hero-indicator');
      indicators.forEach((ind, i) => {
        if (i === index) {
          ind.className = 'hero-indicator w-8 h-1.5 rounded-full bg-[#E50914] transition-all';
        } else {
          ind.className = 'hero-indicator w-2.5 h-1.5 rounded-full bg-white/30 hover:bg-white/60 transition-all';
        }
      });
    }

    document.querySelectorAll('.hero-indicator').forEach((btn, idx) => {
      btn.addEventListener('click', () => renderHeroSlide(idx));
    });

    document.getElementById('hero-watch-btn').addEventListener('click', () => {
      triggerDualActionPlay(HERO_SLIDES[currentSlideIndex]);
    });

    document.getElementById('hero-add-btn').addEventListener('click', () => {
      addToWatchlist(HERO_SLIDES[currentSlideIndex]);
    });

    // Auto rotate hero slide every 8 seconds
    setInterval(() => {
      currentSlideIndex = (currentSlideIndex + 1) % HERO_SLIDES.length;
      renderHeroSlide(currentSlideIndex);
    }, 8000);


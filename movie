    /* =========================================================
       1. SISTEM HALAMAN / MENU SIDEBAR (State Management)
       ========================================================= */
    const navButtons = document.querySelectorAll('.nav-item');
    const viewPanels = document.querySelectorAll('.view-panel');

    function switchNav(targetNavId) {
      // 1. Update button styling
      navButtons.forEach(btn => {
        const isTarget = btn.getAttribute('data-nav') === targetNavId;
        if (isTarget) {
          btn.className = 'nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-white bg-[#E50914] shadow-md shadow-red-900/20';
        } else {
          btn.className = 'nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-slate-400 hover:text-white hover:bg-white/5';
        }
      });

      // 2. Switch visible view panel
      viewPanels.forEach(panel => {
        if (panel.id === `view-${targetNavId}`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });

      // Clear search when switching tabs
      clearSearch();

      // Trigger lazy render for sub views
      if (targetNavId === 'watchlist') renderWatchlistView();
      if (targetNavId === 'coming-soon') renderComingSoon();
      if (targetNavId === 'discovery') renderDiscovery();
      if (targetNavId === 'friends') renderFriends();
      if (targetNavId === 'parties') renderParties();
      if (targetNavId === 'media') renderMedia();

      // Close mobile drawer if open
      closeMobileMenu();

      // Re-create icons for updated view
      lucide.createIcons();
    }

    navButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const navId = btn.getAttribute('data-nav');
        switchNav(navId);
      });
    });

    /* =========================================================
       3. LIVE SEARCH FILTER
       ========================================================= */
    const searchInput = document.getElementById('search-input');
    const searchClearBtn = document.getElementById('search-clear-btn');
    const searchResultsSection = document.getElementById('search-results-section');
    const searchResultsGrid = document.getElementById('search-results-grid');
    const searchQueryDisplay = document.getElementById('search-query-display');
    const searchCount = document.getElementById('search-count');

    function executeLiveSearch(query) {
      const q = query.trim().toLowerCase();
      if (!q) {
        clearSearch();
        return;
      }

      searchClearBtn.classList.remove('hidden');
      searchResultsSection.classList.remove('hidden');
      searchQueryDisplay.textContent = `"${query}"`;

      // Filter catalog
      const matched = ALL_MOVIES.filter(m => 
        m.title.toLowerCase().includes(q) ||
        (m.category && m.category.toLowerCase().includes(q)) ||
        (m.desc && m.desc.toLowerCase().includes(q)) ||
        (m.description && m.description.toLowerCase().includes(q))
      );

      searchCount.textContent = `${matched.length} found`;

      if (matched.length === 0) {
        searchResultsGrid.innerHTML = `
          <div class="col-span-full py-10 text-center text-slate-500">
            <i data-lucide="search-x" class="w-10 h-10 mx-auto mb-2 opacity-60"></i>
            <p class="text-sm font-semibold">No streaming titles matched "${query}"</p>
            <p class="text-xs text-slate-600 mt-1">Try keywords like 'Action', 'Sci-Fi', 'Money', or 'Heist'.</p>
          </div>
        `;
      } else {
        searchResultsGrid.innerHTML = matched.map(m => createMovieCardHTML(m)).join('');
        attachCardListeners(searchResultsGrid, matched);
      }

      lucide.createIcons({ root: searchResultsGrid });
    }

    function clearSearch() {
      searchInput.value = '';
      searchClearBtn.classList.add('hidden');
      searchResultsSection.classList.add('hidden');
      searchResultsGrid.innerHTML = '';
    }

    searchInput.addEventListener('input', (e) => executeLiveSearch(e.target.value));
    searchClearBtn.addEventListener('click', clearSearch);

    /* =========================================================
       4. FITUR NIGHT & LIGHT MODE TOGGLE
       Beralih mulus antara Dark Mode elegan (#0b0b0e) dan Light Mode (#f8fafc)
       ========================================================= */
    const themeToggleBtn = document.getElementById('theme-toggle-btn');
    const themeIcon = document.getElementById('theme-icon');
    const themeText = document.getElementById('theme-text');
    const appBody = document.getElementById('app-body');
    const mainSidebar = document.getElementById('main-sidebar');
    const mainHeader = document.getElementById('main-header');
    const rightRail = document.getElementById('right-rail');

    function applyTheme(isDark) {
      isDarkMode = isDark;
      const htmlEl = document.documentElement;

      if (isDark) {
        htmlEl.classList.add('dark');
        appBody.classList.remove('bg-[#f8fafc]', 'text-slate-900');
        appBody.classList.add('bg-[#0b0b0e]', 'text-slate-100');

        mainSidebar.classList.remove('bg-white', 'border-slate-200');
        mainSidebar.classList.add('bg-[#101015]', 'border-[#1f1f28]');

        mainHeader.classList.remove('bg-white/95', 'border-slate-200');
        mainHeader.classList.add('bg-[#0b0b0e]/95', 'border-[#1a1a24]');

        rightRail.classList.remove('bg-slate-50', 'border-slate-200');
        rightRail.classList.add('bg-[#0f0f15]', 'border-[#1f1f2a]');

        themeText.textContent = 'Night';
        themeIcon.setAttribute('data-lucide', 'moon');
        themeIcon.className = 'w-4 h-4 text-amber-400';
      } else {
        htmlEl.classList.remove('dark');
        appBody.classList.remove('bg-[#0b0b0e]', 'text-slate-100');
        appBody.classList.add('bg-[#f8fafc]', 'text-slate-900');

        mainSidebar.classList.remove('bg-[#101015]', 'border-[#1f1f28]');
        mainSidebar.classList.add('bg-white', 'border-slate-200');

        mainHeader.classList.remove('bg-[#0b0b0e]/95', 'border-[#1a1a24]');
        mainHeader.classList.add('bg-white/95', 'border-slate-200');

        rightRail.classList.remove('bg-[#0f0f15]', 'border-[#1f1f2a]');
        rightRail.classList.add('bg-slate-50', 'border-slate-200');

        themeText.textContent = 'Light';
        themeIcon.setAttribute('data-lucide', 'sun');
        themeIcon.className = 'w-4 h-4 text-amber-500';
      }
      lucide.createIcons();
    }

    themeToggleBtn.addEventListener('click', () => {
      applyTheme(!isDarkMode);
      showToast(isDarkMode ? 'Switched to Night Mode (#0b0b0e)' : 'Switched to Light Mode (#f8fafc)');
    });

    /* =========================================================
       5. INTERAKTIF TAMBAHAN (Notification, Mobile Drawer, etc.)
       ========================================================= */
    // Notification Toast
    document.getElementById('btn-notification').addEventListener('click', () => {
      showToast('No new notifications. All 4K streams nominal.');
    });

    // VIP Stream Top Nav Click
    document.getElementById('btn-direct-link-top').addEventListener('click', () => {
      window.open(DIRECT_LINK, '_blank', 'noopener,noreferrer');
      showToast('Opening VIP Stream Partner (Direct Link)', 'ad');
    });

    // Profile & Logout Buttons
    document.getElementById('btn-profile-badge').addEventListener('click', () => {
      showToast('Biradhwaj (Graphic Designer) - Active Subscription');
    });

    document.getElementById('btn-logout').addEventListener('click', () => {
      showToast('Session locked. Logging out...');
    });

    // Generic View More Toasts
    document.querySelectorAll('.btn-toast-viewmore').forEach(btn => {
      btn.addEventListener('click', () => {
        showToast('Loading additional movie catalog...');
      });
    });

    // Clear Watchlist Button
    const clearWatchlistBtn = document.getElementById('btn-clear-watchlist');
    if (clearWatchlistBtn) {
      clearWatchlistBtn.addEventListener('click', () => {
        WATCHLIST = [];
        updateWatchlistBadge();
        renderWatchlistView();
        showToast('Watchlist cleared');
      });
    }

    // Save Settings Button
    const saveSettingsBtn = document.getElementById('btn-save-settings');
    if (saveSettingsBtn) {
      saveSettingsBtn.addEventListener('click', () => {
        showToast('Streaming preferences saved successfully!', 'success');
      });
    }

    // Mobile Sidebar Drawer Toggle
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileBackdrop = document.getElementById('mobile-backdrop');

    function openMobileMenu() {
      mainSidebar.classList.remove('-translate-x-full');
      mobileBackdrop.classList.remove('opacity-0', 'pointer-events-none');
    }

    function closeMobileMenu() {
      mainSidebar.classList.add('-translate-x-full');
      mobileBackdrop.classList.add('opacity-0', 'pointer-events-none');
    }

    mobileMenuToggle.addEventListener('click', openMobileMenu);
    mobileBackdrop.addEventListener('click', closeMobileMenu);

    /* =========================================================
       INIT APPLICATION ON LOAD
       ========================================================= */
    window.addEventListener('DOMContentLoaded', () => {
      renderCelebrities();
      renderHeroSlide(0);
      renderNewReleases();
      renderTopRated();
      renderRightRailPopular();
      renderRightRailFavorites();
      updateWatchlistBadge();
      lucide.createIcons();
    });
  </script>
</body>
</html>

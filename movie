<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StreamFlix - Corporate Streaming Platform</title>
  <meta name="description" content="Professional on-demand corporate streaming platform clone with dynamic navigation, live search, interactive video modal, and monetization banner integration.">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              red: '#E50914',
              hover: '#C11119',
              dark: '#0b0b0e',
              surface: '#141419',
              card: '#1a1a22',
              border: '#262630',
              textMuted: '#94a3b8'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            display: ['Bebas Neue', 'Impact', 'sans-serif']
          }
        }
      }
    }
  </script>

  <!-- Google Fonts: Inter & Bebas Neue -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0b0b0e;
    }
    ::-webkit-scrollbar-thumb {
      background: #2a2a35;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #E50914;
    }

    /* Light mode scrollbar */
    html:not(.dark) ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    html:not(.dark) ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
    }

    /* Smooth transitions */
    .theme-transition {
      transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
    }

    /* Horizontal scroll hide bar */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>

<body class="bg-[#0b0b0e] text-slate-100 font-sans antialiased overflow-x-hidden theme-transition" id="app-body">

  <!-- TOAST NOTIFICATION CONTAINER -->
  <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- VIDEO MODAL PLAYER POPUP -->
  <div id="video-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">
    <div class="relative w-full max-w-4xl mx-4 bg-[#141419] dark:bg-[#141419] rounded-2xl overflow-hidden shadow-2xl border border-slate-700/50 transform scale-95 transition-transform duration-300" id="video-modal-card">
      <!-- Modal Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-[#0f0f14]">
        <div class="flex items-center gap-3">
          <span class="px-2 py-0.5 text-xs font-bold bg-[#E50914] text-white rounded">NOW PLAYING</span>
          <h3 id="modal-movie-title" class="text-lg font-bold text-white truncate max-w-md">Money Heist</h3>
        </div>
        <button id="modal-close-btn" class="p-2 rounded-full text-slate-400 hover:text-white hover:bg-white/10 transition" title="Close player">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Video Player Area -->
      <div class="relative aspect-video bg-black flex items-center justify-center group">
        <video id="main-video-player" class="w-full h-full object-contain" controls poster="https://images.unsplash.com/photo-1574375927938-d5a98e8ffe85?auto=format&fit=crop&w=1200&q=85">
          <source id="video-source" src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/TearsOfSteel.mp4" type="video/mp4">
          Your browser does not support HTML5 video.
        </video>
      </div>

      <!-- Modal Footer Details -->
      <div class="p-6 bg-[#141419] flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-3 text-sm text-slate-400 mb-1">
            <span id="modal-movie-category" class="text-[#E50914] font-semibold">Action / Crime</span>
            <span>•</span>
            <span id="modal-movie-year">2021</span>
            <span>•</span>
            <span id="modal-movie-rating" class="px-1.5 py-0.5 text-xs border border-slate-700 rounded text-slate-300">TV-MA</span>
            <span>•</span>
            <span id="modal-movie-match" class="text-emerald-400 font-medium">98% Match</span>
          </div>
          <p id="modal-movie-desc" class="text-sm text-slate-300 max-w-2xl">Masterminded by The Professor, a gang of unusual robbers attempts the grandest heist in modern history.</p>
        </div>
        <div class="flex items-center gap-3">
          <button id="modal-directlink-btn" class="flex items-center gap-2 px-4 py-2 text-sm font-semibold bg-white/10 hover:bg-white/20 text-white rounded-lg transition">
            <i data-lucide="external-link" class="w-4 h-4"></i>
            <span>Stream Source (Ad)</span>
          </button>
          <button id="modal-watchlist-btn" class="flex items-center gap-2 px-4 py-2 text-sm font-semibold bg-[#E50914] hover:bg-[#C11119] text-white rounded-lg transition">
            <i data-lucide="bookmark-plus" class="w-4 h-4"></i>
            <span>Add to List</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- APPLICATION WRAPPER (Responsive Flexbox Layout) -->
  <div class="flex min-h-screen">

    <!-- LEFT SIDEBAR -->
    <aside id="main-sidebar" class="fixed inset-y-0 left-0 z-40 w-64 bg-[#101015] border-r border-[#1f1f28] flex flex-col transition-transform duration-300 -translate-x-full md:translate-x-0 theme-transition">
      <!-- Brand Logo -->
      <div class="h-20 flex items-center px-6 gap-3 border-b border-[#1f1f28]/60">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#E50914] to-red-600 flex items-center justify-center shadow-lg shadow-red-900/30">
          <i data-lucide="play" class="w-5 h-5 text-white fill-white ml-0.5"></i>
        </div>
        <div>
          <span class="text-2xl font-black tracking-wider text-[#E50914] font-display">STREAMFLIX</span>
          <span class="block text-[10px] uppercase font-bold tracking-widest text-slate-400">STUDIO HUB</span>
        </div>
      </div>

      <!-- Navigation Menus (Dynamic State Management) -->
      <div class="flex-1 overflow-y-auto px-4 py-6 space-y-8 no-scrollbar">
        <!-- Main Menu Section -->
        <div>
          <span class="px-3 text-[11px] font-bold tracking-wider uppercase text-slate-500">Menu</span>
          <nav class="mt-2 space-y-1">
            <button data-nav="home" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-white bg-[#E50914] shadow-md shadow-red-900/20">
              <i data-lucide="home" class="w-4 h-4"></i>
              <span>Home</span>
            </button>
            <button data-nav="watchlist" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-slate-400 hover:text-white hover:bg-white/5">
              <i data-lucide="bookmark" class="w-4 h-4"></i>
              <span>Watch List</span>
              <span id="watchlist-badge" class="ml-auto text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-300">3</span>
            </button>
            <button data-nav="coming-soon" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-slate-400 hover:text-white hover:bg-white/5">
              <i data-lucide="calendar" class="w-4 h-4"></i>
              <span>Coming Soon</span>
            </button>
            <button data-nav="discovery" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-slate-400 hover:text-white hover:bg-white/5">
              <i data-lucide="compass" class="w-4 h-4"></i>
              <span>Discovery</span>
            </button>
          </nav>
        </div>

        <!-- Social & Community Section -->
        <div>
          <span class="px-3 text-[11px] font-bold tracking-wider uppercase text-slate-500">Social</span>
          <nav class="mt-2 space-y-1">
            <button data-nav="friends" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-slate-400 hover:text-white hover:bg-white/5">
              <i data-lucide="users" class="w-4 h-4"></i>
              <span>Friends</span>
            </button>
            <button data-nav="parties" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-slate-400 hover:text-white hover:bg-white/5">
              <i data-lucide="tv" class="w-4 h-4"></i>
              <span>Parties</span>
              <span class="ml-auto text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800">LIVE</span>
            </button>
            <button data-nav="media" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-slate-400 hover:text-white hover:bg-white/5">
              <i data-lucide="folder-kanban" class="w-4 h-4"></i>
              <span>Media</span>
            </button>
          </nav>
        </div>

        <!-- General Section -->
        <div>
          <span class="px-3 text-[11px] font-bold tracking-wider uppercase text-slate-500">General</span>
          <nav class="mt-2 space-y-1">
            <button data-nav="setting" class="nav-item w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-slate-400 hover:text-white hover:bg-white/5">
              <i data-lucide="settings" class="w-4 h-4"></i>
              <span>Setting</span>
            </button>
            <button id="btn-logout" class="w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition text-slate-400 hover:text-red-400 hover:bg-red-500/10">
              <i data-lucide="log-out" class="w-4 h-4"></i>
              <span>Log Out</span>
            </button>
          </nav>
        </div>
      </div>

      <!-- User Profile Card in Sidebar Footer -->
      <div class="p-4 border-t border-[#1f1f28]/60 bg-[#0d0d12]">
        <div class="flex items-center gap-3">
          <div class="relative">
            <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80" alt="Biradhwaj Avatar" class="w-10 h-10 rounded-full object-cover border border-slate-700">
            <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 border-2 border-[#101015] rounded-full"></span>
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-sm font-semibold text-white truncate">Biradhwaj</h4>
            <p class="text-xs text-slate-400 truncate">Graphic Designer</p>
          </div>
          <button id="btn-profile-badge" class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 transition" title="Profile Details">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
          </button>
        </div>
      </div>
    </aside>

    <!-- MOBILE SIDEBAR BACKDROP -->
    <div id="mobile-backdrop" class="fixed inset-0 bg-black/60 z-30 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"></div>

    <!-- MAIN APP CONTAINER (Content & Right Rail) -->
    <div class="flex-1 flex flex-col md:pl-64 min-w-0">

      <!-- TOP NAVBAR -->
      <header class="sticky top-0 z-30 h-20 bg-[#0b0b0e]/95 backdrop-blur-md border-b border-[#1a1a24] px-4 md:px-8 flex items-center justify-between gap-4 theme-transition" id="main-header">
        
        <!-- Left: Mobile Menu Toggle & Brand for Mobile -->
        <div class="flex items-center gap-3">
          <button id="mobile-menu-toggle" class="p-2 rounded-xl text-slate-300 hover:bg-white/5 md:hidden" title="Toggle Navigation">
            <i data-lucide="menu" class="w-6 h-6"></i>
          </button>
          <div class="hidden sm:flex items-center gap-2 text-xs font-semibold text-slate-400">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
            <span>CORPORATE CLOUD STREAM 4K</span>
          </div>
        </div>

        <!-- Center: Live Search Bar -->
        <div class="flex-1 max-w-xl">
          <div class="relative group">
            <i data-lucide="search" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 group-focus-within:text-[#E50914] transition"></i>
            <input 
              type="text" 
              id="search-input" 
              placeholder="Search by title, genre, cast or director..." 
              class="w-full pl-10 pr-10 py-2 text-sm bg-[#15151c] text-slate-100 placeholder-slate-400 rounded-xl border border-[#23232f] focus:outline-none focus:border-[#E50914] focus:ring-1 focus:ring-[#E50914] transition"
            >
            <button id="search-clear-btn" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 hidden">
              <i data-lucide="circle-x" class="w-4 h-4"></i>
            </button>
          </div>
        </div>

        <!-- Right: Actions & Theme Toggle -->
        <div class="flex items-center gap-3">
          <!-- Notification Bell -->
          <div class="relative">
            <button id="btn-notification" class="p-2.5 rounded-xl bg-[#15151c] border border-[#23232f] text-slate-300 hover:text-white hover:border-slate-600 transition relative" title="Notifications">
              <i data-lucide="bell" class="w-4 h-4"></i>
              <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-[#E50914]"></span>
            </button>
          </div>

          <!-- Night / Light Mode Toggle Button -->
          <button id="theme-toggle-btn" class="flex items-center gap-2 px-3 py-2 rounded-xl bg-[#15151c] border border-[#23232f] text-slate-200 hover:text-white hover:border-slate-600 text-xs font-semibold transition" title="Toggle Theme">
            <i data-lucide="moon" id="theme-icon" class="w-4 h-4 text-amber-400"></i>
            <span id="theme-text">Night</span>
          </button>

          <!-- Direct Link Quick Access Button -->
          <button id="btn-direct-link-top" class="hidden lg:flex items-center gap-2 px-3.5 py-2 rounded-xl bg-gradient-to-r from-red-600 to-[#E50914] text-white text-xs font-bold hover:shadow-lg hover:shadow-red-900/30 transition">
            <i data-lucide="zap" class="w-3.5 h-3.5"></i>
            <span>VIP Stream</span>
          </button>
        </div>
      </header>

      <!-- MAIN LAYOUT BODY (Content Area + Right Sidebar) -->
      <div class="flex-1 flex flex-col xl:flex-row min-w-0">

        <!-- DYNAMIC CONTENT CONTAINER (Driven by JavaScript State) -->
        <main class="flex-1 p-4 md:p-8 min-w-0" id="main-content-view">
          
          <!-- SEARCH RESULTS OVERLAY SECTION (Toggled when searching) -->
          <div id="search-results-section" class="hidden mb-8">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i data-lucide="search" class="w-5 h-5 text-[#E50914]"></i>
                <span>Search Results for: <span id="search-query-display" class="text-slate-400 italic font-normal"></span></span>
              </h2>
              <span id="search-count" class="text-xs font-medium px-2 py-1 rounded bg-slate-800 text-slate-300">0 found</span>
            </div>
            <div id="search-results-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
              <!-- Rendered via JS -->
            </div>
          </div>

          <!-- VIEW 1: HOME FEED (Default) -->
          <div id="view-home" class="view-panel space-y-8">
            
            <!-- CELEBRITIES STORIES BAR -->
            <section>
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-xs font-bold tracking-wider uppercase text-slate-400 flex items-center gap-2">
                  <i data-lucide="sparkles" class="w-3.5 h-3.5 text-[#E50914]"></i>
                  <span>Popular Celebrities</span>
                </h3>
                <button class="btn-toast-viewmore text-xs font-semibold text-[#E50914] hover:underline">View All</button>
              </div>
              <div class="flex items-center gap-4 overflow-x-auto pb-2 no-scrollbar" id="celebrity-stories-bar">
                <!-- Injected via JS -->
              </div>
            </section>

            <!-- HERO CAROUSEL BANNER -->
            <section class="relative rounded-2xl overflow-hidden border border-[#242432] shadow-2xl bg-gradient-to-r from-black/90 to-transparent group" id="hero-banner">
              <div class="relative h-[380px] sm:h-[420px] md:h-[460px] w-full">
                <!-- Background Image -->
                <img id="hero-bg-img" src="https://images.unsplash.com/photo-1574375927938-d5a98e8ffe85?auto=format&fit=crop&w=1400&q=85" alt="Hero Banner" class="absolute inset-0 w-full h-full object-cover object-center transition-all duration-700">
                <div class="absolute inset-0 bg-gradient-to-t from-[#0b0b0e] via-[#0b0b0e]/70 to-transparent"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-[#0b0b0e] via-[#0b0b0e]/40 to-transparent"></div>

                <!-- Hero Content Overlay -->
                <div class="absolute bottom-0 left-0 p-6 md:p-10 max-w-2xl z-10">
                  <div class="flex flex-wrap items-center gap-2.5 mb-3">
                    <span class="px-2.5 py-1 text-xs font-black tracking-wider bg-[#E50914] text-white rounded">NEW SEASON</span>
                    <span id="hero-match" class="text-xs font-bold text-emerald-400 px-2 py-0.5 rounded bg-emerald-950/60 border border-emerald-800">98% Match</span>
                    <span id="hero-rating" class="text-xs font-medium px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700">TV-MA</span>
                    <span id="hero-duration" class="text-xs text-slate-400 font-medium">50m per ep</span>
                  </div>

                  <h1 id="hero-title" class="text-4xl sm:text-5xl md:text-6xl font-black text-white font-display tracking-wide mb-2 drop-shadow-md">MONEY HEIST</h1>
                  
                  <p id="hero-category" class="text-sm font-semibold text-slate-300 mb-2">Action / Crime / Thriller • Season 5 Finale</p>
                  
                  <p id="hero-description" class="text-xs sm:text-sm text-slate-400 line-clamp-3 mb-6 max-w-xl leading-relaxed">
                    An unusual group of robbers attempt to carry out the most perfect robbery in Spanish history - stealing 2.4 billion euros from the Royal Mint of Spain, masterminded by The Professor.
                  </p>

                  <div class="flex items-center gap-3">
                    <!-- Watch Button (Dual Action) -->
                    <button id="hero-watch-btn" class="flex items-center gap-2 px-6 py-3 rounded-xl bg-[#E50914] hover:bg-[#C11119] text-white font-bold text-sm shadow-xl shadow-red-900/30 transition transform hover:-translate-y-0.5">
                      <i data-lucide="play" class="w-4 h-4 fill-white"></i>
                      <span>Watch Trailer</span>
                    </button>
                    <!-- Add to Watchlist -->
                    <button id="hero-add-btn" class="flex items-center gap-2 px-4 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm backdrop-blur-md border border-white/10 transition">
                      <i data-lucide="bookmark-plus" class="w-4 h-4"></i>
                      <span>Add to List</span>
                    </button>
                  </div>
                </div>

                <!-- Carousel Slide Indicators -->
                <div class="absolute bottom-6 right-6 z-10 flex items-center gap-2" id="hero-indicators">
                  <button class="hero-indicator w-8 h-1.5 rounded-full bg-[#E50914] transition-all" data-slide="0"></button>
                  <button class="hero-indicator w-2.5 h-1.5 rounded-full bg-white/30 hover:bg-white/60 transition-all" data-slide="1"></button>
                  <button class="hero-indicator w-2.5 h-1.5 rounded-full bg-white/30 hover:bg-white/60 transition-all" data-slide="2"></button>
                </div>
              </div>
            </section>

            <!-- SECTION: NEW RELEASE (Continue Watching / New Releases) -->
            <section id="section-new-release">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-5 bg-[#E50914] rounded-full"></span>
                  <h3 class="text-lg font-bold text-white tracking-wide">New Release & Trending</h3>
                </div>
                <div class="flex items-center gap-2">
                  <button class="btn-toast-viewmore text-xs font-semibold text-slate-400 hover:text-white transition">Explore Category &rarr;</button>
                </div>
              </div>

              <!-- Grid Cards -->
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="new-release-grid">
                <!-- Rendered by JS -->
              </div>
            </section>

            <!-- ========================================================================= -->
            <!-- [MONETISASI WAJIB 1]: BANNER_HORIZONTAL PERSIS DI BAWAH SECTION NEW RELEASE -->
            <!-- ========================================================================= -->
            <section class="my-6">
              <div class="text-[10px] uppercase font-bold tracking-widest text-slate-500 mb-1.5 flex items-center justify-between">
                <span>Sponsored Advertisement (728x90)</span>
                <span class="text-slate-600">Leaderboard</span>
              </div>
              <!-- BANNER_HORIZONTAL CONTAINER -->
              <div class="w-full overflow-hidden rounded-xl border border-slate-800 bg-[#121218] p-2 flex items-center justify-center min-h-[90px] hover:border-slate-700 transition" id="banner-horizontal-slot">
                <!-- Paste script iklan horizontal 728x90 di sini -->
                <a href="https://www.contoh-direct-link-adsterra.com/xyz123" target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-between px-6 py-3 bg-gradient-to-r from-red-950/40 via-[#181822] to-slate-900 border border-red-900/30 rounded-lg group">
                  <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg bg-[#E50914]/20 border border-[#E50914]/40 flex items-center justify-center text-[#E50914]">
                      <i data-lucide="sparkles" class="w-5 h-5"></i>
                    </div>
                    <div>
                      <span class="text-xs font-bold text-white group-hover:text-red-400 transition">ADSTERRA 728x90 HORIZONTAL LEADERBOARD BANNER</span>
                      <p class="text-[11px] text-slate-400">Click to unlock unlimited 4K ultra-speed corporate streaming access</p>
                    </div>
                  </div>
                  <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold bg-[#E50914] text-white rounded-lg group-hover:bg-[#C11119] transition">
                    Visit Sponsor
                    <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>
                  </span>
                </a>
              </div>
            </section>
            <!-- ========================================================================= -->

            <!-- SECTION: TOP RATED & POPULAR ON PLATFORM -->
            <section>
              <div class="flex items-center justify-between mb-4">
